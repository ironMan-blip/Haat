# The MCP server reads these from the environment (it loads no .env file itself).
HAAT_URL=http://localhost:5174                 # the Haat site, where buyers sign in (the OAuth issuer)
HAAT_API=http://127.0.0.1:8000/api            # where this server calls the API (Django itself)
MCP_HOST=127.0.0.1                            # only this machine can reach the server
MCP_PORT=8100
MCP_RESOURCE_URL=http://127.0.0.1:8100/mcp    # this server's address; the backend must use the same value
